spring:
  application:
    name: zaoral-backend
  datasource:
    url: ${DATABASE_URL:jdbc:postgresql://192.168.0.219:5432/zaoral}
    username: ${DATABASE_USERNAME:zaoral}
    password: ${DATABASE_PASSWORD:zaoral_dev_password}
  jpa:
    hibernate:
      ddl-auto: none
      # 既定の命名戦略は引用符付きの "User" を "user" に小文字化してしまうため、名前をそのまま使う戦略にする。
      # カラム名はエンティティ側で @Column(name = ...) により明示する。
      naming:
        physical-strategy: org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
    open-in-view: false
  flyway:
    baseline-on-migrate: true
    baseline-version: 0

server:
  port: ${PORT:8080}

management:
  endpoints:
    web:
      exposure:
        include: health
